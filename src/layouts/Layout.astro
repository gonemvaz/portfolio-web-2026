---
import '../styles/global.css';
import profile from '../data/profile.json';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.description} />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@500,700&f[]=zodiak@701&display=swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@1,700&family=Instrument+Sans:wght@500;700&display=swap" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
