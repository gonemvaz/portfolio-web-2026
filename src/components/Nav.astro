---
import allSections from '../data/sections.json';

// Las secciones con "hidden": true en sections.json no aparecen en el menú.
const sections = allSections.filter((s) => !('hidden' in s && s.hidden));
---
<nav class="nav" id="siteNav" aria-label="Secciones">
  <ol id="navlist">
    {sections.map((s, i) => <li><a href={`#${s.id}`} aria-current={i === 0 ? 'true' : undefined}>{s.label}</a></li>)}
  </ol>
</nav>
