---
import Icon from './Icon.astro';
---
<div class="tools">
  <button id="theme" type="button" aria-label="Cambiar entre modo claro y oscuro" title="Modo claro u oscuro">
    <Icon name="moon" class="icon-moon" />
    <Icon name="sun" class="icon-sun" />
  </button>
  <button id="up" type="button" aria-label="Volver al inicio" title="Volver al inicio">
    <Icon name="up" />
  </button>
</div>
